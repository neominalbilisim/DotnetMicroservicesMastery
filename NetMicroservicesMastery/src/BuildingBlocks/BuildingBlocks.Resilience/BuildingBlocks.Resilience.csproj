<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    IHostApplicationBuilder / IConfiguration gibi hosting tiplerini kullanabilmek
    için shared framework referansı (bkz. BuildingBlocks.Common açıklaması).
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Modül 2: Resiliency Patterns (Polly) -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.0.0" />
    <PackageReference Include="Polly" Version="8.5.0" />
    <!-- Modül 2: Secret Management -->
    <PackageReference Include="VaultSharp" Version="1.17.5.1" />
    <!-- Modül 5: Distributed Lock (Redis / RedLock.net) -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.24" />
    <PackageReference Include="RedLock.net" Version="2.3.2" />
  </ItemGroup>

</Project>
